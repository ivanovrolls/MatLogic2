# Copy this to .env.production (or set these in your hosting platform's env vars).

# Your deployed Django backend — no trailing slash
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# Only needed if media files are served from a separate CDN / S3 custom domain
# (i.e. you set AWS_S3_CUSTOM_DOMAIN on the backend). Omit otherwise.
# NEXT_PUBLIC_MEDIA_DOMAIN=media.yourdomain.com
