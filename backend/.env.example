# ── Core ─────────────────────────────────────────────────────────────────────
# Generate a key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-long-random-secret-key-here
DEBUG=False
# Comma-separated. Include your API subdomain and bare domain.
ALLOWED_HOSTS=api.yourdomain.com,yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
# Preferred on Railway / Render / Heroku — set DATABASE_URL and skip the DB_* vars.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Alternatively use individual vars (only if DATABASE_URL is not set):
# DB_NAME=matlogic
# DB_USER=matlogic_user
# DB_PASSWORD=strong-password-here
# DB_HOST=localhost
# DB_PORT=5432

# Connection pooling (seconds). 60 is a safe default for most hosts.
CONN_MAX_AGE=60

# ── CORS & CSRF ───────────────────────────────────────────────────────────────
# Comma-separated list of your frontend origins (no trailing slash).
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Media / File Storage (S3-compatible) ──────────────────────────────────────
# Set USE_S3=True so uploads persist across deploys (avatars, post images, videos).
# Compatible with AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces, etc.
USE_S3=True
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# For AWS S3, set the region (e.g. us-east-1):
AWS_S3_REGION_NAME=us-east-1
# For non-AWS providers (Cloudflare R2, Backblaze B2), set the endpoint URL:
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# Optional: custom CDN domain in front of the bucket (omit for direct S3 URLs):
# AWS_S3_CUSTOM_DOMAIN=media.yourdomain.com

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate both keys with: python manage.py generate_vapid_keys
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_CLAIMS_EMAIL=admin@yourdomain.com

# ── Native Push (Firebase / FCM) ──────────────────────────────────────────────
# Used for iOS (via APNs) and Android push notifications inside the Capacitor app.
# 1. Create a Firebase project at https://console.firebase.google.com
# 2. Register iOS app (bundle ID: com.matlogic.app) and Android app (same ID)
# 3. Download the service account key: Project Settings → Service Accounts → Generate new key
# 4. Place the JSON file on your server and set the path below
# 5. For the native project:
#    - Android: put google-services.json in android/app/
#    - iOS: put GoogleService-Info.plist in ios/App/App/
FIREBASE_CREDENTIALS_PATH=/etc/matlogic/firebase-service-account.json
